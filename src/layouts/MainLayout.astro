---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "src/components/Header.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      type="image/svg+xml"
      rel="icon"
      href="/favicon-light.svg"
      media="(prefers-color-scheme: light)"
    />

    <link
      type="image/svg+xml"
      rel="icon"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Descripción clara de tu proyecto" />
    <!-- Preload fuentes para mejorar rendimiento -->
    <link
      rel="preload"
      href="/src/assets/fonts/Literata-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Literata-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Literata-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Literata-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Literata-Italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Inter-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Inter-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Zodiak-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/src/assets/fonts/Zodiak-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Maleanta blog"
      href={new URL("rss.xml", Astro.site)}
    />
    <title>{title}</title>

    <meta
      name="description"
      content="Editorial independiente del sur de Madrid con interés en la publicación de obras de contenido transformador con identidad propia."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://maleanta.com/" />

    <!-- Open Graph (para redes sociales) -->
    <meta property="og:title" content="Maleanta — Ediciones" />
    <meta
      property="og:description"
      content="Contenido, ideas y proyectos editoriales con identidad propia."
    />
    <meta
      property="og:url"
      content="https://mastodon.social/@maleantaediciones"
    />
    <meta
      property="og:url"
      content="https://www.facebook.com/maleantaediciones/"
    />
    <meta
      property="og:url"
      content="https://www.instagram.com/maleantaediciones/"
    />
    <meta property="og:url" content="https://x.com/maleantaediciones" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://maleanta.com/icons/path2.svg" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Maleanta — Ediciones" />
    <meta
      name="twitter:description"
      content="Contenido, ideas y proyectos editoriales con identidad propia."
    />
    <meta name="twitter:image" content="https://maleanta.com/icons/path2.svg" />

    <!-- Theme -->
    <meta name="theme-color" content="#E5E7EB" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Maleanta Ediciones",
        "url": "https://maleanta.com",
        "description": "Editorial independiente del sur de Madrid con interés en la publicación de obras de contenido transformador con identidad propia."
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="">
      <slot />
    </main>
  </body>
</html>
