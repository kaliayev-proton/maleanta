---
import { Image } from "astro:assets";
import MainLayout from "src/layouts/MainLayout.astro";
import logo1 from "../assets/images/maleanta_logo1.png";

---

<MainLayout title="Maleanta Ediciones">
  <div class="grid grid-cols-1">
    <div class="font-zodiak col-span-2 items-center justify-center text-center">
      <p class="text-5xl text-mal-font-paragraph">
        404
      </p>
      <p class="text-3xl text-mal-font-paragraph">
        La página que buscas no existe.
      </p>

      <div class="flex items-center justify-center mt-20">
        <Image src={logo1} alt="Autor" width={150} />
      </div>
    </div>
  </div>
</MainLayout>