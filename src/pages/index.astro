---
import { getCollection } from "astro:content";
import TypeBlogPost from "src/components/TypeBlogPost.astro";
import { siteConfig } from "../config/site-config";
import MainLayout from "../layouts/MainLayout.astro";

const blogPosts = await getCollection(
  "blog",
  (post) => post.data.isDraft === false,
);
---

<MainLayout title="Maleanta Editorial">
  <div class="">
    <div class="">
      <div class="">
        <a class="btn mr-4 text-brand-900" href="/blog/1">Go to Blog</a>
        <a class="btn mr-4 text-brand-900" href="/authors">Go to Authors</a>
        <div class="trapezoid bg-amber-200 flex flex-wrap">
          <p class="text-color-mal-font font-telma text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-color-mal-font font-zodiak text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-color-mal-font font-literata text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-color-mal-font font-inter text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-color-mal-font font-grotesk text-2xl">
            {siteConfig.description}
          </p>
        </div>
      </div>
      <div
        class=""
      >
        {blogPosts.map((post, index) => <TypeBlogPost post={post} key={index} />)}
      </div>
    </div>
  </div>
</MainLayout>

<style>
  @reference "tailwindcss";
  a {
    @apply text-blue-500 hover:underline hover:text-blue-600 cursor-pointer;
  }
</style>
