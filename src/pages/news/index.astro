---
import { type CollectionEntry, getCollection } from "astro:content";
import TypeBlogPost from "src/components/TypeBlogPost.astro";
import MainLayout from "src/layouts/MainLayout.astro";
import { siteConfig } from "../../config/site-config";

const blogPosts = await getCollection(
  "blog",
  (post: CollectionEntry<"blog">) => post.data.isDraft === false,
);
---

<MainLayout title="Maleanta Editorial">
  <div class="">
    <div class="">
      <div class="">
        <a class="btn-primary mr-4 text-mal-primary" href="/blog/1"
          >Go to Blog</a
        >
        <a class="btn-primary mr-4 text-mal-primary" href="/authors"
          >Go to Authors</a
        >
        <div class="trapezoid bg-mal-secondary flex flex-wrap">
          <p class="text-mal-primary font-telma text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-mal-primary font-zodiak text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-mal-primary font-literata text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-mal-primary font-inter text-2xl">
            {siteConfig.description}
          </p>
          <p class="text-mal-primary font-grotesk text-2xl">
            {siteConfig.description}
          </p>
        </div>
      </div>
      <div class="">
        {
          blogPosts.map((post: any, index: number) => (
            <TypeBlogPost post={post} key={index} />
          ))
        }
      </div>
    </div>
  </div>
</MainLayout>
