---
import { siteConfig } from "../config/site-config";
---

<header class="p-5 mb-20 mt-2 flex items-center justify-center">
  <h1 class="lowecase type-writer text-mal-font font-grotesk text-8xl">
    {[...siteConfig.title].map((char, i) => <span class={`${i === 7 ? 'text-mal-accent' : ''}`}>{char}</span>)}
  </h1>
</header>
